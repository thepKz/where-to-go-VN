# Sao chép tệp này thành .env.local khi chạy trên máy. Trên Vercel thì nhập vào mục Environment Variables.
# Mọi giá trị ở đây đi cùng trang web tới trình duyệt nên chỉ để khoá công khai. Không bao giờ để khoá service_role.

# Chọn nơi lưu dữ liệu của nhà. Đặt supabase khi đưa lên mạng. Để trống thì chạy bản thử trên máy và nối http://localhost:4504.
VITE_STORE=
# Địa chỉ dự án Supabase, dạng https://abcdxyz.supabase.co (Project Settings, API).
VITE_SUPABASE_URL=
# Khoá công khai anon hoặc publishable của dự án Supabase (cùng trang với địa chỉ).
VITE_SUPABASE_ANON_KEY=
# Không bắt buộc. Địa chỉ tệp dữ liệu chỗ nếu không dùng tệp đóng gói sẵn /data/places.json.
VITE_DATA_URL=
# Chỉ cho bản thử trên máy. Địa chỉ máy chủ đồng bộ thử, mặc định http://localhost:4504.
VITE_SYNC_URL=
